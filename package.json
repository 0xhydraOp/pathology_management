{
  "name": "mondal-diagnostic-centre",
  "version": "1.1.0",
  "description": "Pathology Management System \u2014 fully offline pathology laboratory workspace",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "build:icon": "node scripts/build-icon.mjs",
    "test": "node scripts/test-system.js && node --test scripts/test-result-integrity.js scripts/test-reference-intervals.cjs scripts/test-reference-hardening.cjs scripts/test-print-profile.cjs scripts/test-authorization.cjs scripts/test-recovery.cjs scripts/test-administrator-recovery.cjs scripts/test-onboarding.cjs scripts/test-billing-integrity.cjs scripts/test-offline-migration.cjs scripts/test-login-throttling.cjs scripts/test-report-amendments.cjs scripts/test-billing-ledger.cjs scripts/test-clinical-software.cjs scripts/test-backup-health.cjs scripts/test-professional-migration.cjs scripts/test-database-ownership.cjs scripts/test-release-review.cjs scripts/test-inno-configuration.cjs",
    "release": "node scripts/create-release.js",
    "electron:build": "node scripts/build-windows.cjs",
    "release:clean": "node scripts/clean-release.js",
    "start": "electron ."
  },
  "dependencies": {
    "jsbarcode": "^3.12.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.4",
    "sql.js": "^1.11.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "png-to-ico": "^3.0.1",
    "sharp": "0.35.5",
    "vite": "6.4.4",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.mondal.diagnostic",
    "productName": "Pathology Management System",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "build/license.txt",
      "pathology_parameters.json",
      "rate_chart.json",
      "test_profiles.json"
    ],
    "extraFiles": [
      {
        "from": "build/Recover Administrator.cmd",
        "to": "Recover Administrator.cmd"
      },
      {
        "from": "docs/RECOVERY.md",
        "to": "RECOVERY.md"
      },
      {
        "from": "WINDOWS_INSTALL.txt",
        "to": "READ_ME_FIRST_Windows_Install.txt"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "third-party-licenses",
        "to": "third-party-licenses"
      },
      {
        "from": "docs/OFFLINE_RELEASE.md",
        "to": "OFFLINE_RELEASE.md"
      },
      {
        "from": "docs/MANUAL_UPDATE.md",
        "to": "MANUAL_UPDATE.md"
      },
      {
        "from": "docs/RESTORE_REHEARSAL.md",
        "to": "RESTORE_REHEARSAL.md"
      },
      {
        "from": "docs/CLINICAL_REVIEW_PACK.md",
        "to": "CLINICAL_REVIEW_PACK.md"
      },
      {
        "from": "docs/CLINICAL_RULE_INVENTORY.json",
        "to": "CLINICAL_RULE_INVENTORY.json"
      },
      {
        "from": "docs/REPORT_AMENDMENTS.md",
        "to": "REPORT_AMENDMENTS.md"
      },
      {
        "from": "docs/BILLING_LEDGER.md",
        "to": "BILLING_LEDGER.md"
      },
      {
        "from": "docs/INNO_INSTALLATION.md",
        "to": "INNO_INSTALLATION.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "artifactName": "Pathology Management System Offline Setup ${version}.exe"
    },
    "forceCodeSigning": false,
    "icon": "build/icon.ico"
  },
  "overrides": {
    "concurrently": {
      "shell-quote": "1.12.0"
    },
    "@electron/get": {
      "global-agent": "4.1.3"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "author": "Robiul Islam Molla",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xhydraOp/pathology_management.git"
  }
}
