{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "patholy-licensing",
  "account_id": "ee7ee1773b4a103da1f8019ec2c58633",
  "main": "src/index.js",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "patholy-licensing",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "ACTIVATION_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "vars": {
    "SIGNING_KID": "REPLACE_BEFORE_DEPLOYMENT",
    "ACCESS_ISSUER": "https://REPLACE.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "REPLACE_BEFORE_DEPLOYMENT",
    "CUSTOMER_ACCESS_AUDIENCE": "REPLACE_BEFORE_DEPLOYMENT",
    "RATE_LIMIT_MAX": "30",
    "RATE_LIMIT_WINDOW": "60",
  },
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": false },
}
